# ==============================================================
# Autonomous E-Commerce Operations Specialist - Environment Config
# ==============================================================

# Google Gemini API Key (Get free from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Email Service (SendGrid or Resend) - Leaves mock mode if empty
# SENDGRID_API_KEY=SG.your_sendgrid_key_here
# RESEND_API_KEY=re_your_resend_key_here
SENDER_EMAIL=ops@ecommerce-store.internal

# Server Port
PORT=5001

# Proactive Scheduler Cron Expression (Default: Every 15 minutes)
# For demo testing, you can use "*/1 * * * *" for every 1 minute
CRON_SCHEDULE=*/15 * * * *
